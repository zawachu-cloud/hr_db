# .env.example — DB 實驗連線範本(複製為 .env.dev / .env.prod 並填真實值;.env.* 已 gitignore)
#
# ⚠️ 金鑰規範(見 AGENTS.md):service_role 僅後端用、嚴禁進前端或版控;真實值只放 .env.*。
# 本 repo 的 .env.dev / .env.prod 已由 hr 主專案複製真實憑證(已授權使用,勿印出值、勿提交)。

# ── 環境標籤 ──
APP_ENV=dev                                      # dev(沙盒,實驗預設)/ prod(正式,破壞性動作禁用)

# ── Supabase 專案 ──
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF            # dev=xdznbojweiyvfaeuwjaj / prod=vdvcysrbxxfonylodkrk
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY           # 前端 / PostgREST 可見性驗證用
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  # 僅後端;切勿外流(prod 檔才有)

# ── DB 直連(psql / 實驗)──
# dev 直連為 IPv6(本機常連不到),psql 走 pooler:host aws-0-<region>.pooler.supabase.com、user postgres.<ref>
# dev 在 ap-southeast-2、prod 在 ap-southeast-1。
SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD
SUPABASE_DB_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase CLI(migration / functions)──
SUPABASE_ACCESS_TOKEN=YOUR-ACCESS-TOKEN
